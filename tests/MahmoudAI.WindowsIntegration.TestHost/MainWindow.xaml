<Window
    x:Class="MahmoudAI.WindowsIntegration.TestHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Mahmoud AI UIA Test Host">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="16">
            <TextBlock
                AutomationProperties.AutomationId="HeaderText"
                AutomationProperties.Name="UIA Semantic Test Host"
                FontSize="28"
                Text="UIA Semantic Test Host" />

            <StackPanel
                AutomationProperties.AutomationId="SettingsPane"
                AutomationProperties.Name="Settings Pane"
                Spacing="12">
                <TextBox
                    x:Name="NameInput"
                    AutomationProperties.AutomationId="NameInput"
                    AutomationProperties.Name="Name input"
                    Header="Name"
                    PlaceholderText="Type a name" />
                <CheckBox
                    x:Name="DarkModeToggle"
                    AutomationProperties.AutomationId="DarkModeToggle"
                    AutomationProperties.Name="Dark mode"
                    Content="Dark mode" />
                <ComboBox
                    x:Name="LanguageList"
                    AutomationProperties.AutomationId="LanguageList"
                    AutomationProperties.Name="Language list"
                    Header="Language"
                    SelectedIndex="0">
                    <ComboBoxItem Content="English" />
                    <ComboBoxItem Content="العربية" />
                    <ComboBoxItem Content="Deutsch" />
                </ComboBox>
            </StackPanel>

            <StackPanel
                AutomationProperties.AutomationId="ActionsPane"
                AutomationProperties.Name="Actions Pane"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    x:Name="SaveButton"
                    AutomationProperties.AutomationId="SaveButton"
                    AutomationProperties.Name="Save"
                    Click="SaveButton_Click"
                    Content="Save" />
                <Button
                    x:Name="DuplicateSaveButton"
                    AutomationProperties.AutomationId="DuplicateSaveButton"
                    AutomationProperties.Name="Save"
                    Content="Save" />
                <Button
                    AutomationProperties.AutomationId="DisabledButton"
                    AutomationProperties.Name="Disabled action"
                    IsEnabled="False"
                    Content="Disabled" />
                <Button
                    AutomationProperties.AutomationId="HiddenButton"
                    AutomationProperties.Name="Hidden action"
                    Visibility="Collapsed"
                    Content="Hidden" />
            </StackPanel>

            <Border
                AutomationProperties.AutomationId="CaptureFixturePanel"
                AutomationProperties.Name="Capture fixture"
                Background="#101827"
                CornerRadius="8"
                Padding="20"
                Width="640"
                Height="260">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        AutomationProperties.AutomationId="CaptureFixtureTitle"
                        AutomationProperties.Name="Capture fixture title"
                        Foreground="#9FE7FF"
                        FontSize="22"
                        Text="CAPTURE FIXTURE / WINDOW TARGET" />
                    <Grid Grid.Row="1" Margin="0,16,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="8">
                            <TextBlock Foreground="White" FontSize="18" Text="Mahmoud AI" />
                            <TextBlock Foreground="#CBD5E1" Text="Deterministic visual content for Windows Graphics Capture E2E." TextWrapping="Wrap" />
                            <TextBlock
                                AutomationProperties.AutomationId="CaptureFixtureEnglish"
                                AutomationProperties.Name="English fixture text"
                                Foreground="#FDE68A"
                                Text="English: Window capture fixture" />
                            <TextBlock
                                AutomationProperties.AutomationId="CaptureFixtureArabic"
                                AutomationProperties.Name="Arabic fixture text"
                                FlowDirection="RightToLeft"
                                Foreground="#FDE68A"
                                Text="العربية: عينة التقاط النافذة" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <Ellipse Fill="#38BDF8" Width="64" Height="64" />
                            <TextBlock Foreground="#BAE6FD" Text="SAFE" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <TextBlock
                        Grid.Row="2"
                        AutomationProperties.AutomationId="CaptureFixtureFooter"
                        AutomationProperties.Name="Capture fixture footer"
                        Foreground="#94A3B8"
                        Text="No persistence • No OCR • No VLM" />
                </Grid>
            </Border>

            <TextBlock
                x:Name="StatusText"
                AutomationProperties.AutomationId="StatusText"
                AutomationProperties.Name="Status"
                Text="Ready" />
        </StackPanel>
    </ScrollViewer>
</Window>
