<Window
    x:Class="MahmoudAI.WindowsIntegration.TestHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Mahmoud AI UIA Test Host">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="16">
            <TextBlock
                AutomationProperties.AutomationId="HeaderText"
                AutomationProperties.Name="UIA Semantic Test Host"
                FontSize="28"
                Text="UIA Semantic Test Host" />

            <StackPanel
                AutomationProperties.AutomationId="SettingsPane"
                AutomationProperties.Name="Settings Pane"
                Spacing="12">
                <TextBox
                    x:Name="NameInput"
                    AutomationProperties.AutomationId="NameInput"
                    AutomationProperties.Name="Name input"
                    Header="Name"
                    PlaceholderText="Type a name" />
                <CheckBox
                    x:Name="DarkModeToggle"
                    AutomationProperties.AutomationId="DarkModeToggle"
                    AutomationProperties.Name="Dark mode"
                    Content="Dark mode" />
                <ComboBox
                    x:Name="LanguageList"
                    AutomationProperties.AutomationId="LanguageList"
                    AutomationProperties.Name="Language list"
                    Header="Language"
                    SelectedIndex="0">
                    <ComboBoxItem Content="English" />
                    <ComboBoxItem Content="العربية" />
                    <ComboBoxItem Content="Deutsch" />
                </ComboBox>
            </StackPanel>

            <StackPanel
                AutomationProperties.AutomationId="ActionsPane"
                AutomationProperties.Name="Actions Pane"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    x:Name="SaveButton"
                    AutomationProperties.AutomationId="SaveButton"
                    AutomationProperties.Name="Save"
                    Click="SaveButton_Click"
                    Content="Save" />
                <Button
                    x:Name="DuplicateSaveButton"
                    AutomationProperties.AutomationId="DuplicateSaveButton"
                    AutomationProperties.Name="Save"
                    Content="Save" />
                <Button
                    AutomationProperties.AutomationId="DisabledButton"
                    AutomationProperties.Name="Disabled action"
                    IsEnabled="False"
                    Content="Disabled" />
                <Button
                    AutomationProperties.AutomationId="HiddenButton"
                    AutomationProperties.Name="Hidden action"
                    Visibility="Collapsed"
                    Content="Hidden" />
            </StackPanel>

            <TextBlock
                x:Name="StatusText"
                AutomationProperties.AutomationId="StatusText"
                AutomationProperties.Name="Status"
                Text="Ready" />
        </StackPanel>
    </ScrollViewer>
</Window>
